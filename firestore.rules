rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    // Validation for UserFavorite
    function isValidUserFavorite(data) {
      return data.shoeId is string && data.shoeId.size() <= 64 &&
             data.shoeName is string && data.shoeName.size() <= 100 &&
             data.price is number;
    }

    // Validation for UserOrder
    function isValidUserOrder(data) {
      return data.orderId is string && data.orderId.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.mpesaReceiptNumber is string && data.mpesaReceiptNumber.size() <= 30 &&
             data.totalAmountKSh is number &&
             data.status is string && data.status.size() <= 30;
    }

    // Match users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // Disallow list queries on users root to protect PII
      allow create: if isValidId(userId) && isOwner(userId) && 
                      incoming().uid == request.auth.uid &&
                      isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && 
                      incoming().uid == existing().uid &&
                      isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);

      // Subcollection for user's favorite footwear
      match /favorites/{shoeId} {
        allow read: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && 
                        isValidId(shoeId) &&
                        isValidUserFavorite(incoming());
        allow update: if isValidId(userId) && isOwner(userId) && 
                        isValidId(shoeId) &&
                        isValidUserFavorite(incoming());
        allow delete: if isValidId(userId) && isOwner(userId) && isValidId(shoeId);
      }

      // Subcollection for user's order history
      match /orders/{orderId} {
        allow read: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && 
                        isValidId(orderId) &&
                        incoming().userId == request.auth.uid &&
                        isValidUserOrder(incoming());
        allow update, delete: if false; // Order receipts are immutable
      }
    }

    // Health / connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
